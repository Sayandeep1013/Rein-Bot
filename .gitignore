# --- Secrets -----------------------------------------------------------------
# This repository is intended to be public. .env.local holds a real Supabase
# personal access token; it must never be committed.
.env.local
.env*.local
.env
!.env.example

# --- Scratch -----------------------------------------------------------------
# CLAUDE.md mandates that temp output lives in .tmp/ inside this folder.
.tmp/

# Agent scratch state
.sisyphus/

# Machine-specific agent settings; .claude/settings.json IS committed on purpose
# (CLAUDE.md keeps permissions config inside the project).
.claude/settings.local.json

# --- Node / Vercel (implementation phase) ------------------------------------
node_modules/
dist/
build/
.next/
.vercel/
*.tsbuildinfo

# --- Supabase CLI ------------------------------------------------------------
supabase/.temp/
supabase/.branches/

# --- Media -------------------------------------------------------------------
# Transcoded clips belong in Supabase Storage, never in git.
*.webm
*.mp4
*.mkv

# --- Curation run artifacts --------------------------------------------------
# .github/workflows/curate.yml writes these into the working directory: the
# flattened/deduped/sliced job lists, the question_bank pre-check, per-theme
# results and the built objects. On a runner they vanish with the VM, but the
# local harness in .tmp/ runs the same steps from the repo root, and none of it
# should ever be committed. The built stills and audio in particular belong in
# Supabase Storage and in the run artifact, nowhere else.
/flat.jsonl
/deduped.jsonl
/pool.jsonl
/jobs.jsonl
/results.jsonl
/theme.json
/existing.json
/existing.keys
/out/
/work/
__pycache__/
*.pyc

# --- Logs / OS / editor ------------------------------------------------------
*.log
npm-debug.log*
Thumbs.db
Desktop.ini
.DS_Store
.idea/
*.swp
