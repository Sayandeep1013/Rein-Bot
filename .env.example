# ReIN Bot — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored and must
# never be committed: this repository is intended to be public.

# Supabase personal access token (starts with "sbp_").
# Create at: https://supabase.com/dashboard/account/tokens
# Used by the Supabase MCP server (see opencode.json) and by the Management API.
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Target project: "ReIN Bot" in organization "Personal Projects".
# Not a secret — a project ref appears in every client-side URL.
SUPABASE_PROJECT_REF=mxkqivivqultfuattuin
